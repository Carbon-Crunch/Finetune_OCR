# ==============================================================================
# Industrial Document OCR Configuration
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Inference Server Settings (testing/server.py)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BASE_MODEL=unsloth/qwen2.5-vl-7b-instruct-unsloth-bnb-4bit
ADAPTER_PATH=./saves_v1
MIN_PIXELS=200704
MAX_PIXELS=1003520

# ------------------------------------------------------------------------------
# Fine-Tuning & Evaluation Settings (training/training.py & evaluate.py)
# ------------------------------------------------------------------------------
EPOCHS=3
MAX_SAMPLES=0
PER_DEVICE_BATCH=1
GRAD_ACCUM=8
LEARNING_RATE=1e-4
LORA_RANK=32
ROTATION_AUG_PER_DOC=4
PHOTO_AUG_ENABLED=1
PHOTO_AUG_PROB=0.5
MERGE_WEIGHTS=0

# ------------------------------------------------------------------------------
# External Vision LLM API Keys (training/batch_processor.py & update_gtr_orientation.py)
# ------------------------------------------------------------------------------
# Optional: Google Gemini API key(s)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Optional: Groq API key (for fast orientation auto-labeling)
GROQ_API_KEY=
