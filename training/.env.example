# ==============================================================================
# Training & Pipeline Environment Variables (training/)
# Copy to .env:
#   cp .env.example .env
# ==============================================================================

# Hyperparameters
EPOCHS=3
MAX_SAMPLES=0
PER_DEVICE_BATCH=1
GRAD_ACCUM=8
LEARNING_RATE=1e-4
LORA_RANK=32
ROTATION_AUG_PER_DOC=4
PHOTO_AUG_ENABLED=1
PHOTO_AUG_PROB=0.5
MERGE_WEIGHTS=0

# Optional API Keys for Vision LLMs (orientation update & dataset processor)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GROQ_API_KEY=
